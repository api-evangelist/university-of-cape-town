          "request": {
            "name": "Get one study by persistent identifier",
            "description": {
              "content": "Returns the full record for a single study, addressed by its persistent IDNO (not its numeric id \u2014 a numeric id returns 400 IDNO-NOT-FOUND). The response carries a `dataset` object plus a nested `metadata` block holding the study's DDI-style documentation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "catalog",
                "{{idno}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "mwi-alpha-him-karonga-2002-2017-v1",
                  "key": "idno",
                  "description": "Persistent study identifier (IDNO)."
                }
              ]
            },
            "method": "GET"
          },
